def read_nmnist_file(file_path):
    """
    Args:
        file_path (str): Path to the N-MNIST file to read.
    Returns:
        x_coords (list): List of x-coordinates of the events.
        y_coords (list): List of y-coordinates of the events.
        polarities (list): List of polarities of the events.
        timestamps (list): List of timestamps of the events.
    """
    x_coords = []
    y_coords = []
    polarities = []
    timestamps = []

    with open(file_path, 'rb') as f:
        data = f.read()
        for i in range(0, len(data), 5):
            event = data[i:i+5]

            # Unpack the 5 bytes
            combined = int.from_bytes(event, byteorder='big')
            
            # Extract fields
            x = (combined >> 32) & 0xFF
            y = (combined >> 24) & 0xFF
            polarity = (combined >> 23) & 0x01
            timestamp = combined & 0x7FFFFF
            
            x_coords.append(x)
            y_coords.append(y)
            polarities.append(polarity)
            timestamps.append(timestamp)
    
    return x_coords, y_coords, polarities, timestamps

def create_image(x_coords, y_coords, polarities, image_size=(34, 34)):
    image = np.zeros(image_size, dtype=np.int32)
    for x, y, polarity in zip(x_coords, y_coords, polarities):
        if polarity == 1:
            image[y, x] += 1 
    return image

def event_to_spike_train(x_coords, y_coords, polarities, timestamps, delta_t=1000, max_num_steps=350):
    """
    Args:
        x_coords: List of x-coordinates of events (len = num_events)
        y_coords: List of y-coordinates of events (len = num_events)
        polarities: List of polarities of events (len = num_events)
        timestamps: List of timestamps of events (len = num_events)
        delta_t: Time interval for discretization
    Returns:
        spike_train: Spike train tensor (shape = max_num_steps, num_neurons)
    """
    spike_train = torch.zeros(max_num_steps, 34*34)
    for x, y, p, t in zip(x_coords, y_coords, polarities, timestamps):
        spike_train[t // delta_t, y*34 + x] = 1
    
    return spike_train

class NMNISTDataset(torch.utils.data.Dataset):
    def __init__(self, file_paths, delta_t=1000, max_num_steps=350):
        self.file_paths = file_paths
        self.delta_t = delta_t
        self.max_num_steps = max_num_steps

    def __len__(self):
        return len(self.file_paths)

    def __getitem__(self, idx):
        file_path, target = self.file_paths[idx]
        x_coords, y_coords, polarities, timestamps = read_nmnist_file(file_path)
        spike_train = event_to_spike_train(x_coords, y_coords, polarities, timestamps, self.delta_t, self.max_num_steps)
        return spike_train, target
    
def get_file_paths_and_targets(root_dir='n-mnist_data/Train/Train'):
    """
    Args:
        root_dir (str): Root directory containing the N-MNIST dataset.
    Returns:
        file_paths (list of tuples): List of (file path, target) tuples for the dataset.
    """
    file_paths = []
    for root, dirs, files in os.walk(root_dir):
        for file in files:
            folder_name = os.path.basename(root)
            file_paths.append((os.path.join(root, file), int(folder_name)))
    return file_paths

train_file_paths_and_targets = get_file_paths_and_targets(root_dir='n-mnist_data/Train/Train')
train_dataset = NMNISTDataset(train_file_paths_and_targets)

